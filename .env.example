# ============================================================
# IBM CLOUD CONFIGURATION — copy this file to .env and fill in your values
# ============================================================

# IBM Watson Machine Learning / watsonx.ai credentials
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
IBM_CLOUD_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSON_PROJECT_ID=your_watsonx_project_id_here

# IBM Models (confirmed available on watsonx.ai Lite)
IBM_GRANITE_MODEL_ID=mistralai/mistral-small-3-1-24b-instruct-2503
IBM_GRANITE_INSTRUCT_MODEL=mistralai/mistral-small-3-1-24b-instruct-2503
IBM_GRANITE_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr-v2

# IBM Watson Discovery (optional)
WATSON_DISCOVERY_API_KEY=your_watson_discovery_api_key_here
WATSON_DISCOVERY_URL=https://api.us-south.discovery.watson.cloud.ibm.com
WATSON_DISCOVERY_PROJECT_ID=your_discovery_project_id_here

# ============================================================
# APPLICATION SETTINGS
# ============================================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=change_this_to_a_random_secret_key

# RAG Configuration
VECTOR_STORE_PATH=./data/vector_store
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5

# Interview Settings
MAX_QUESTIONS_PER_SESSION=10
LOG_LEVEL=INFO
LOG_FILE=./logs/interview_trainer.log